<!DOCTYPE html>
<html lang="zh">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
    <title>To 恩：</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body {
            background: #1a1a1a;
            min-height: 100vh;
            position: relative;
            overflow: hidden;
            font-family: 'Microsoft YaHei', '微软雅黑', 'PingFang SC', sans-serif;
            touch-action: none; /* 禁止触摸滚动 */
        }
        /* 提示信息 */
        #info {
            position: fixed;
            bottom: 20px;
            left: 0;
            right: 0;
            text-align: center;
            color: rgba(255, 255, 255, 0.7);
            font-size: 14px;
            text-shadow: 1px 1px 3px rgba(0,0,0,0.5);
            pointer-events: none;
            z-index: 9999;
        }
        /* 祝福窗口卡片 */
        .love-window {
            position: absolute;
            width: 180px;
            min-height: 60px;
            padding: 12px 6px;
            border-radius: 20px;
            box-shadow: 0 10px 20px rgba(0,0,0,0.3), 0 0 0 2px rgba(255,255,255,0.3);
            display: flex;
            align-items: center;
            justify-content: center;
            text-align: center;
            font-size: 22px;
            font-weight: bold;
            color: white;
            text-shadow: 1px 1px 4px rgba(0,0,0,0.3);
            backdrop-filter: blur(2px);
            border: 1px solid rgba(255,255,255,0.5);
            animation: popIn 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
            word-break: break-word;
            line-height: 1.4;
            letter-spacing: 1px;
        }
        @keyframes popIn {
            0% { transform: scale(0.2); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }
        /* 手机小屏幕适配 */
        @media (max-width: 600px) {
            .love-window {
                width: 140px;
                font-size: 18px;
                padding: 10px 4px;
            }
        }
        /* 极窄屏幕再小一点 */
        @media (max-width: 380px) {
            .love-window {
                width: 120px;
                font-size: 16px;
            }
        }
    </style>
</head>
<body>

<div id="info">✨ 正在派送心意... ✨</div>

